{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Learner or staff account profile with account status.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "preferredLanguage": { "type": "string", "enum": ["en", "rw"] },
        "role": { "type": "string", "enum": ["superadmin", "admin", "course_manager", "instructor", "reviewer", "support_staff", "learner"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "suspensionReason": { "type": "string", "maxLength": 400 },
        "privacyConsentAcceptedAt": { "type": "string", "maxLength": 64 },
        "marketingOptIn": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "preferredLanguage", "role", "accountStatus", "createdAt", "updatedAt"]
    },
    "StaffRoleRecord": {
      "title": "StaffRoleRecord",
      "description": "Authoritative RBAC role and granular permissions assignment managed strictly by Superadmin.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["superadmin", "admin", "course_manager", "instructor", "reviewer", "support_staff"] },
        "permissions": { "type": "array" },
        "assignedCourseIds": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "permissions", "assignedCourseIds", "status", "updatedBy", "createdAt", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Bilingual course catalog entry with English and Kinyarwanda metadata and builder settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "minLength": 1, "maxLength": 128 },
        "code": { "type": "string", "minLength": 1, "maxLength": 32 },
        "status": { "type": "string", "enum": ["draft", "in_review", "active", "upcoming", "scheduled", "archived"] },
        "category": { "type": "string", "enum": ["foundations", "prompting", "automation", "agents", "industry"] },
        "visibility": { "type": "string", "enum": ["public", "unlisted", "private"] },
        "isFree": { "type": "boolean" },
        "priceRwf": { "type": "number" },
        "durationDays": { "type": "number" },
        "capacity": { "type": "number" },
        "enrolledCount": { "type": "number" },
        "certificateEligible": { "type": "boolean" },
        "levelRange": { "type": "string", "maxLength": 40 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "startDate": { "type": "string", "maxLength": 64 },
        "endDate": { "type": "string", "maxLength": 64 },
        "coverImageUrl": { "type": "string", "maxLength": 500 },
        "promoVideoUrl": { "type": "string", "maxLength": 500 },
        "prerequisitesText": { "type": "string", "maxLength": 500 },
        "seoTitle": { "type": "string", "maxLength": 160 },
        "seoDescription": { "type": "string", "maxLength": 320 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "titleRw": { "type": "string", "minLength": 1, "maxLength": 160 },
        "subtitleEn": { "type": "string", "maxLength": 260 },
        "subtitleRw": { "type": "string", "maxLength": 260 },
        "descriptionEn": { "type": "string", "maxLength": 2000 },
        "descriptionRw": { "type": "string", "maxLength": 2000 },
        "outcomesEn": { "type": "array" },
        "outcomesRw": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "slug", "code", "status", "priceRwf", "durationDays", "titleEn", "titleRw", "updatedAt"]
    },
    "CourseModule": {
      "title": "CourseModule",
      "description": "Structured course module container grouping ordered lessons.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
