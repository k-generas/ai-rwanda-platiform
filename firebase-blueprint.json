        "titleEn": { "type": "string", "minLength": 1, "maxLength": 180 },
        "titleRw": { "type": "string", "minLength": 1, "maxLength": 180 },
        "summaryEn": { "type": "string", "maxLength": 1000 },
        "summaryRw": { "type": "string", "maxLength": 1000 },
        "releaseAt": { "type": "string", "maxLength": 64 },
        "releaseAtMs": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courseId", "orderIndex", "titleEn", "titleRw", "isPublished", "updatedAt"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Shared lesson identity holding English and Kinyarwanda structured instructional blocks.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "moduleId": { "type": "string", "maxLength": 128 },
        "orderIndex": { "type": "number" },
        "dayNumber": { "type": "number" },
        "weekNumber": { "type": "number" },
        "isSample": { "type": "boolean" },
        "isRequired": { "type": "boolean" },
        "estimatedMinutes": { "type": "number" },
        "enStatus": { "type": "string", "enum": ["draft", "published"] },
        "rwStatus": { "type": "string", "enum": ["draft", "translation_needed", "published"] },
        "releaseAt": { "type": "string", "maxLength": 64 },
        "releaseAtMs": { "type": "number" },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 180 },
        "titleRw": { "type": "string", "minLength": 1, "maxLength": 180 },
        "summaryEn": { "type": "string", "maxLength": 4000 },
        "summaryRw": { "type": "string", "maxLength": 4000 },
        "objectivesEn": { "type": "array" },
        "objectivesRw": { "type": "array" },
        "blocksEnJson": { "type": "string", "maxLength": 200000 },
        "blocksRwJson": { "type": "string", "maxLength": 200000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courseId", "dayNumber", "weekNumber", "isSample", "titleEn", "titleRw", "updatedAt"]
    },
    "LessonVersion": {
      "title": "LessonVersion",
      "description": "Point-in-time snapshot of a structured bilingual lesson for version restoration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lessonId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "courseId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "savedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "note": { "type": "string", "maxLength": 240 },
        "snapshotJson": { "type": "string", "minLength": 2, "maxLength": 250000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "lessonId", "courseId", "savedBy", "snapshotJson", "createdAt"]
    },
    "LearningPath": {
      "title": "LearningPath",
      "description": "Ordered sequence of courses forming a guided educational progression.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "titleEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "titleRw": { "type": "string", "minLength": 2, "maxLength": 160 },
        "descriptionEn": { "type": "string", "maxLength": 1200 },
        "descriptionRw": { "type": "string", "maxLength": 1200 },
        "courseIds": { "type": "array" },
        "isPublished": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "titleEn", "titleRw", "courseIds", "isPublished", "updatedAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Mobile Money transaction record awaiting or passing backend/authorized verification.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courseId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "provider": { "type": "string", "enum": ["mtn_momo", "airtel_money", "manual"] },
        "phoneMasked": { "type": "string", "minLength": 4, "maxLength": 32 },
