      "required": ["id", "userId", "courseId", "provider", "phoneMasked", "amountRwf", "transactionRef", "status", "createdAt"]
    },
    "RefundRecord": {
      "title": "RefundRecord",
      "description": "Commercial refund ledger record tied to a payment.",
